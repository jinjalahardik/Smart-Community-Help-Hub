# API base URL for the Smart Community Help Hub backend.
# For production (Vercel), set this to the public URL of your deployed Express API,
# e.g. https://schub-api.onrender.com/api
# For local dev, keep the localhost value.
VITE_API_BASE_URL=http://localhost:5000/api

# Keep the real backend API enabled (no mock data).
VITE_USE_MOCK_API=false

VITE_APP_NAME=Smart Community Help Hub
