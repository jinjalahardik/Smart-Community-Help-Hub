# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (recommended for production)
# Option A (preferred - avoids SRV DNS issues on some networks): direct shard hosts
# authSource=admin is required. Replace YOUR_ATLAS_PASSWORD with your real password.
# Do NOT commit the real password.
MONGODB_URI=mongodb://schub_user:YOUR_ATLAS_PASSWORD@ac-phbx7bo-shard-00-00.ezshm6t.mongodb.net:27017,ac-phbx7bo-shard-00-01.ezshm6t.mongodb.net:27017,ac-phbx7bo-shard-00-02.ezshm6t.mongodb.net:27017/sch_hub?ssl=true&retryWrites=true&w=majority&authSource=admin
# Option B (SRV - may hit "querySrv ECONNREFUSED" on some networks):
# MONGODB_URI=mongodb+srv://schub_user:YOUR_ATLAS_PASSWORD@cluster0.ezshm6t.mongodb.net/sch_hub?retryWrites=true&w=majority&appName=Cluster0&authSource=admin
# For local dev you can fall back to:
# MONGODB_URI=mongodb://127.0.0.1:27017/sch_hub

# Auth
JWT_SECRET=replace_me_with_a_strong_random_secret
JWT_EXPIRES_IN=7d

# CORS (comma-separated allowed origins). Add your production URL when deployed.
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Email (SMTP) - optional in development; emails logged to console when not set.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@schub.local

# Security
# Set to 'true' in production for secure cookies and HTTPS-only features
# SECURE_COOKIES=false
