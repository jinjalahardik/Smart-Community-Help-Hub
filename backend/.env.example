# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (recommended for production)
# Option A (preferred - avoids SRV DNS issues on some networks): direct shard hosts
# authSource=admin is required. Replace YOUR_ATLAS_PASSWORD with your real password.
# Do NOT commit the real password.
MONGODB_URI=mongodb://USER:PASS@HOST1:27017,HOST2:27017,HOST3:27017/sch_hub?ssl=true&retryWrites=true&w=majority&authSource=admin
# Option B (SRV - may hit "querySrv ECONNREFUSED" on some networks):
# MONGODB_URI=mongodb://USER:PASS@cluster0.example.mongodb.net/sch_hub?retryWrites=true&w=majority
# For local dev you can fall back to:
# MONGODB_URI=mongodb://127.0.0.1:27017/sch_hub

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS (comma-separated allowed origins). Add your production URL when deployed.
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# In development only, requests from a page opened as a local file (file://,
# which browsers send as `Origin: null`, e.g. a sandbox demo HTML opened by
# double-click) are also accepted. This is automatically disabled in
# production (NODE_ENV=production), where only CLIENT_URL + same-origin are
# allowed. Never rely on file:// in production; serve pages over HTTP instead.

# Email (SMTP) - Real email delivery via Nodemailer
# If not configured, OTPs and notifications are logged server-side in development only.
# In production, SMTP configuration is required.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart Community Help Hub <no-reply@yourdomain.com>"

# Security
# Set to 'true' in production for secure cookies and HTTPS-only features
# SECURE_COOKIES=false

# Payments (Celebrate & Give monetary flow)
# Gateway modes:
#   PAYMENT_GATEWAY=sandbox   -> local/demo approval page (default, no keys needed)
#   PAYMENT_GATEWAY=razorpay  -> Razorpay Standard Checkout (TEST MODE ONLY)
# NEVER use live keys with this build; Razorpay live mode is not implemented.
PAYMENT_GATEWAY=sandbox
# Base URL of this API when it differs from localhost (used to build the
# sandbox approval-page URLs returned to the SPA).
# API_BASE_URL=http://localhost:5000
# Secret that signs sandbox webhooks (sandbox mode only). Never commit real secrets.
# PAYMENT_WEBHOOK_SECRET=replace_me_with_webhook_secret
#
# Razorpay TEST MODE ONLY (required when PAYMENT_GATEWAY=razorpay).
# Get test keys from https://dashboard.razorpay.com/app/keys (Test Mode).
# NEVER commit real keys. Razorpay mode fails closed without these.
# RAZORPAY_KEY_ID=rzp_test_YOURKEYID
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret for POST /api/payments/webhook/razorpay (Dashboard ->
# Settings -> Webhooks, test mode). MUST be publicly reachable: Razorpay
# delivers webhooks from its servers, so localhost alone cannot receive
# them â€” use a tunnel (e.g. ngrok) or a deployed URL during testing.
# RAZORPAY_WEBHOOK_SECRET=replace_me_with_razorpay_webhook_secret
